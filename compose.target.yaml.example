services:
  chaos-agent:
    environment:
      CHAOS_TARGET_ID: "${CHAOS_TARGET_ID:?set the verified development target UUID}"
      CHAOS_TARGET_HOST: "${CHAOS_TARGET_HOST:?set the development target host}"
      CHAOS_TARGET_PORT: "${CHAOS_TARGET_PORT:-22}"
      CHAOS_TARGET_USER: "${CHAOS_TARGET_USER:-chaos-agent}"
      CHAOS_TARGET_APACHE_SERVICE: "${CHAOS_TARGET_APACHE_SERVICE:-apache2.service}"
      CHAOS_SSH_CONNECT_TIMEOUT_SECONDS: "${CHAOS_SSH_CONNECT_TIMEOUT_SECONDS:-5}"
      CHAOS_SSH_COMMAND_TIMEOUT_SECONDS: "${CHAOS_SSH_COMMAND_TIMEOUT_SECONDS:-15}"
      CHAOS_PREFLIGHT_MIN_ROOT_FREE_MIB: "${CHAOS_PREFLIGHT_MIN_ROOT_FREE_MIB:-1024}"
      CHAOS_PREFLIGHT_MIN_MEMORY_AVAILABLE_MIB: "${CHAOS_PREFLIGHT_MIN_MEMORY_AVAILABLE_MIB:-256}"
      CHAOS_PREFLIGHT_MAX_LOAD_PER_CPU: "${CHAOS_PREFLIGHT_MAX_LOAD_PER_CPU:-1.50}"
      CHAOS_SITE_HEALTH_URL: "${CHAOS_SITE_HEALTH_URL:?set the externally checked site URL}"
      CHAOS_SITE_EXPECTED_STATUS: "${CHAOS_SITE_EXPECTED_STATUS:-200}"
      CHAOS_SITE_TIMEOUT_SECONDS: "${CHAOS_SITE_TIMEOUT_SECONDS:-5}"
      CHAOS_SITE_MAX_RESPONSE_BYTES: "${CHAOS_SITE_MAX_RESPONSE_BYTES:-65536}"
    volumes:
      - type: bind
        source: ./secrets/ssh/id_ed25519
        target: /run/secrets/chaos-agent/ssh/id_ed25519
        read_only: true
        bind:
          create_host_path: false
      - type: bind
        source: ./secrets/ssh/known_hosts
        target: /run/secrets/chaos-agent/ssh/known_hosts
        read_only: true
        bind:
          create_host_path: false
