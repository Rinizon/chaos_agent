# Install as /etc/sudoers.d/chaos-agent with root:root ownership and mode 0440.
Cmnd_Alias CHAOS_AGENT_PHASE2 = /usr/local/libexec/chaos-agent/target-helper version, \
    /usr/local/libexec/chaos-agent/target-helper identity, \
    /usr/local/libexec/chaos-agent/target-helper preflight

Defaults!CHAOS_AGENT_PHASE2 env_reset, secure_path=/usr/sbin\:/usr/bin\:/sbin\:/bin
chaos-agent ALL=(root) NOPASSWD: CHAOS_AGENT_PHASE2
