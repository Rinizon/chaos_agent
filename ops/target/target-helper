#!/usr/bin/env python3
"""Read-only privileged helper for a positively identified development target."""

from __future__ import annotations

import json
import math
import os
import stat
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path
from typing import Any, Final

HELPER_VERSION: Final = "0.1.0"
PROTOCOL_VERSION: Final = 1
MARKER_PATH: Final = Path("/etc/chaos-agent/target.json")
SUPPORTED_SERVICES: Final = frozenset({"apache2.service", "httpd.service"})
OPERATIONS: Final = frozenset(
    {"version", "identity", "preflight", "apache-stop-preflight", "apache-stop", "apache-start"}
)
MAX_OUTPUT_BYTES: Final = 65_536
MAX_MARKER_BYTES: Final = 4096
CPU_PID_PATH: Final = Path("/run/chaos-agent-cpu-pressure.pid")
MARKER_KEYS: Final = frozenset(
    {"schema_version", "target_id", "environment", "role", "apache_service"}
)


class HelperFailure(Exception):
    """A stable helper failure containing no system diagnostic details."""

    def __init__(self, code: str, exit_code: int = 4) -> None:
        self.code = code
        self.exit_code = exit_code
        super().__init__(code)


def read_marker(path: Path = MARKER_PATH, *, enforce_ownership: bool = True) -> dict[str, Any]:
    """Read and strictly validate the fixed root-owned identity marker."""
    try:
        status = path.lstat()
        if (
            not stat.S_ISREG(status.st_mode)
            or status.st_size < 1
            or status.st_size > MAX_MARKER_BYTES
            or (enforce_ownership and (status.st_uid != 0 or status.st_gid != 0))
            or stat.S_IMODE(status.st_mode) & 0o022
        ):
            raise HelperFailure("marker_invalid")
        raw = path.read_text(encoding="utf-8")
        marker = json.loads(raw)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise HelperFailure("marker_invalid") from error
    if not isinstance(marker, dict) or frozenset(marker) != MARKER_KEYS:
        raise HelperFailure("marker_invalid")
    if type(marker["schema_version"]) is not int or marker["schema_version"] != 1:
        raise HelperFailure("marker_invalid")
    if marker["environment"] != "development" or marker["role"] != "web":
        raise HelperFailure("target_refused")
    if marker["apache_service"] not in SUPPORTED_SERVICES:
        raise HelperFailure("marker_invalid")
    target_id = marker["target_id"]
    if not isinstance(target_id, str) or not _is_canonical_uuid(target_id):
        raise HelperFailure("marker_invalid")
    return marker


def _is_canonical_uuid(value: str) -> bool:
    from uuid import UUID

    try:
        return str(UUID(value)) == value
    except (ValueError, AttributeError):
        return False


def apache_facts(
    service: str,
    runner: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
) -> dict[str, object]:
    """Read Apache installation and active state using fixed systemctl calls."""
    show = runner(
        ["/usr/bin/systemctl", "show", "--property=LoadState", "--value", service],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    installed = show.returncode == 0 and show.stdout.strip() == "loaded"
    active = False
    if installed:
        state = runner(
            ["/usr/bin/systemctl", "is-active", "--quiet", service],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
        active = state.returncode == 0
    return {"service": service, "installed": installed, "active": active}


def apache_control(
    operation: str,
    service: str,
    runner: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
) -> dict[str, object]:
    """Perform one fixed, marker-selected Apache action and report its effect."""
    before = apache_facts(service, runner)
    if not before["installed"]:
        raise HelperFailure("apache_not_installed")
    if operation == "apache-stop-preflight":
        return {**before, "changed": False}
    if operation == "apache-stop":
        if not before["active"]:
            raise HelperFailure("apache_baseline_inactive")
        result = runner(["/usr/bin/systemctl", "stop", service], check=False,
                        capture_output=True, text=True, timeout=5)
        if result.returncode != 0:
            raise HelperFailure("apache_stop_failed")
    elif operation == "apache-start":
        result = runner(["/usr/bin/systemctl", "start", service], check=False,
                        capture_output=True, text=True, timeout=5)
        if result.returncode != 0:
            raise HelperFailure("apache_start_failed")
    else:
        raise HelperFailure("operation_invalid", exit_code=2)
    after = apache_facts(service, runner)
    return {**after, "changed": True}


def cpu_control(operation: str) -> dict[str, object]:
    """Manage one fixed, non-root CPU workload with a root-owned PID record."""
    cpus = os.cpu_count() or 1
    load = os.getloadavg()[0]
    active = False
    owned = False
    if CPU_PID_PATH.exists():
        try:
            pid = int(CPU_PID_PATH.read_text(encoding="ascii"))
            cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").strip()
            owned = cmdline == b"/usr/bin/yes"
            active = owned
        except (OSError, ValueError):
            pass
    if operation == "cpu-pressure-preflight":
        return {"workload_owned": owned, "active": active, "changed": False,
                "logical_cpu_count": cpus, "load_1m": float(load)}
    if operation == "cpu-pressure-start":
        if active:
            raise HelperFailure("cpu_workload_already_active")
        process = subprocess.Popen(["/usr/bin/yes"], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
        CPU_PID_PATH.write_text(str(process.pid), encoding="ascii")
        return {"workload_owned": True, "active": True, "changed": True,
                "logical_cpu_count": cpus, "load_1m": float(load)}
    if operation == "cpu-pressure-stop":
        if active:
            os.kill(pid, 15)
            CPU_PID_PATH.unlink(missing_ok=True)
        return {"workload_owned": False, "active": False, "changed": active,
                "logical_cpu_count": cpus, "load_1m": float(load)}
    raise HelperFailure("operation_invalid", exit_code=2)


def resource_facts(
    statvfs: Callable[[str], os.statvfs_result] = os.statvfs,
    meminfo_path: Path = Path("/proc/meminfo"),
    load_reader: Callable[[], tuple[float, float, float]] = os.getloadavg,
    cpu_reader: Callable[[], int | None] = os.cpu_count,
) -> dict[str, int | float]:
    """Read bounded resource facts without accepting any caller-selected path."""
    try:
        filesystem = statvfs("/")
        memory_available = _read_memory_available(meminfo_path)
        logical_cpu_count = cpu_reader()
        load_1m = load_reader()[0]
    except (OSError, ValueError, IndexError) as error:
        raise HelperFailure("resource_read_failed") from error
    if logical_cpu_count is None or not 1 <= logical_cpu_count <= 1_048_576:
        raise HelperFailure("resource_invalid")
    root_free_bytes = filesystem.f_bavail * filesystem.f_frsize
    if not 0 <= root_free_bytes <= 2**63 - 1:
        raise HelperFailure("resource_invalid")
    if not 0 <= memory_available <= 2**63 - 1:
        raise HelperFailure("resource_invalid")
    if not math.isfinite(load_1m) or not 0 <= load_1m <= 1_000_000:
        raise HelperFailure("resource_invalid")
    return {
        "root_free_bytes": root_free_bytes,
        "memory_available_bytes": memory_available,
        "logical_cpu_count": logical_cpu_count,
        "load_1m": float(load_1m),
    }


def _read_memory_available(path: Path) -> int:
    for line in path.read_text(encoding="ascii").splitlines():
        fields = line.split()
        if len(fields) == 3 and fields[0] == "MemAvailable:" and fields[2] == "kB":
            return int(fields[1]) * 1024
    raise HelperFailure("resource_read_failed")


def build_response(
    operation: str,
    *,
    marker_reader: Callable[[], dict[str, Any]] = read_marker,
    apache_reader: Callable[[str], dict[str, object]] = apache_facts,
    resources_reader: Callable[[], dict[str, int | float]] = resource_facts,
) -> dict[str, object]:
    """Build one response for an already validated closed operation."""
    envelope: dict[str, object] = {
        "protocol_version": PROTOCOL_VERSION,
        "helper_version": HELPER_VERSION,
        "operation": operation,
    }
    if operation == "version":
        return envelope
    marker = marker_reader()
    identity = {
        "marker_schema_version": marker["schema_version"],
        "target_id": marker["target_id"],
        "environment": marker["environment"],
        "role": marker["role"],
        "apache_service": marker["apache_service"],
    }
    envelope.update(identity)
    if operation == "identity":
        return envelope
    if operation in {"apache-stop-preflight", "apache-stop", "apache-start"}:
        envelope.update({"effective_uid": 0, **apache_control(operation, str(marker["apache_service"]))})
        return envelope
    if operation in {"cpu-pressure-preflight", "cpu-pressure-start", "cpu-pressure-stop"}:
        envelope.update({"effective_uid": 0, **cpu_control(operation)})
        return envelope
    envelope.update(
        {
            "effective_uid": 0,
            "apache": apache_reader(str(marker["apache_service"])),
            "resources": resources_reader(),
        }
    )
    return envelope


def emit(payload: dict[str, object]) -> None:
    encoded = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("utf-8")
    if len(encoded) > MAX_OUTPUT_BYTES:
        raise HelperFailure("output_limit_exceeded")
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.write(b"\n")


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        raise HelperFailure("root_required")
    if len(argv) != 2 or argv[1] not in OPERATIONS:
        raise HelperFailure("operation_invalid", exit_code=2)
    emit(build_response(argv[1]))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except HelperFailure as error:
        print(error.code, file=sys.stderr)
        raise SystemExit(error.exit_code) from None
    except Exception:
        print("helper_internal_error", file=sys.stderr)
        raise SystemExit(5) from None
