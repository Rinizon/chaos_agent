# Safe, non-secret Phase 1 configuration example.
# Copy this file to a location outside version control and load it explicitly.
CHAOS_AGENT_ID=chaos-agent-dev
CHAOS_ENVIRONMENT=development
CHAOS_DATA_DIR=/var/lib/chaos-agent
CHAOS_LOG_LEVEL=INFO
CHAOS_LOG_FORMAT=json
CHAOS_HEARTBEAT_INTERVAL_SECONDS=10
CHAOS_HEARTBEAT_MAX_AGE_SECONDS=30

# Phase 2 target access remains disabled until all three values are supplied.
# Replace placeholders only with operator-verified development values.
# CHAOS_TARGET_ID=replace-with-generated-target-uuid
# CHAOS_TARGET_HOST=replace-with-development-host
# CHAOS_SITE_HEALTH_URL=https://replace-with-development-site.example/

# Container SSH paths have safe defaults under /run/secrets/chaos-agent/ssh.
# CHAOS_SSH_PRIVATE_KEY_PATH=/run/secrets/chaos-agent/ssh/id_ed25519
# CHAOS_SSH_KNOWN_HOSTS_PATH=/run/secrets/chaos-agent/ssh/known_hosts
